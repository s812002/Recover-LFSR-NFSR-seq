from sage.rings.polynomial.pbori.pbori import BooleanPolynomialRing
def _var_to_index(var):
    name = str(var)
    for prefix in ('s', 'y'):
        if name.startswith(prefix):
            return int(name[len(prefix):])
    raise ValueError(f"无法解析变量名: {name}")
def recover_g_linear_by_division(H_lin, f_taps, max_y_index):
    """带余除法提取 g 的线性部分和常数项（逻辑不变）"""
    B = H_lin.ring()
    f_sorted = sorted(f_taps)
    if not f_sorted:
        return {'const': False, 'linear': [], 'remaining': H_lin}

    f_max = max(f_sorted)
    shift_cache = {}

    def get_shifted_f(d):
        if d not in shift_cache:
            poly = sum(B.gen(t + d) for t in f_sorted if t + d <= max_y_index)
            shift_cache[d] = poly
        return shift_cache[d]

    remaining = H_lin + B(0)
    recovered_linear = []
    has_const = False
    max_iter = len(list(H_lin)) * 2 + 10

    for _ in range(max_iter):
        if remaining == B(0):
            break
        if remaining == B(1):
            has_const = True
            remaining = B(0)
            break
        var_indices = [_var_to_index(v) for m in remaining
                       for v in m.variables() if m.degree() > 0]
        if not var_indices:
            break
        k = max(var_indices)
        d = k - f_max
        if d < 0:
            break
        shifted = get_shifted_f(d)
        if shifted == B(0):
            break
        remaining += shifted
        recovered_linear.append(d)

    ok = (remaining == B(0))
    print(f"  {'✅' if ok else '⚠️'} 线性除法: {len(recovered_linear)} 项, "
          f"const={has_const}, 除尽={ok}")
    return {'const': has_const, 'linear': sorted(set(recovered_linear)), 'remaining': remaining}
def recover_g_nonlinear_sequence_composition(H_quad, f_taps, max_y_index):
    """
    按您的序列复合定义提取 g 的二次项:
    u_a * u_b 在 H 中贡献的是 { y_{t+a} * y_{t+b} : t in f_taps }
    而非代数展开的完整乘积。
    """
    B = H_quad.ring()
    f_sorted = sorted(f_taps)
    if not f_sorted:
        return []

    # 按差分分组 H 中的二次单项
    diff_groups = {}
    for m in H_quad:
        if m.degree() == 2:
            vs = list(m.variables())
            p, q = sorted([_var_to_index(vs[0]), _var_to_index(vs[1])])
            d = q - p
            diff_groups.setdefault(d, set()).add((p, q))

    recovered_nonlinear = []

    for d, pairs_in_H in sorted(diff_groups.items()):
        # 候选 a: 从 H 中最小下标 p 反推 a = p - min(f_taps)
        # 但也可能是其他 t，所以枚举所有可能的 a
        all_p = sorted(p for (p, q) in pairs_in_H)
        candidate_as = set()
        for p in all_p:
            for t in f_sorted:
                a = p - t
                if a >= 0 and a + d <= max_y_index:
                    candidate_as.add(a)

        verified = []
        for a in sorted(candidate_as):
            b = a + d
            # 构造期望的序列复合块: { y_{t+a} * y_{t+b} : t in f_taps }
            expected_pairs = set()
            valid = True
            for t in f_sorted:
                ta, tb = t + a, t + b
                if ta > max_y_index or tb > max_y_index:
                    valid = False
                    break
                expected_pairs.add((min(ta, tb), max(ta, tb)))

            if not valid or not expected_pairs:
                continue

            # 精确匹配: H 中该差分组必须包含这个完整块
            if expected_pairs.issubset(pairs_in_H):
                verified.append((a, b))

        print(f"  diff={d}: 候选a={len(candidate_as)}, 验证通过={len(verified)}")
        recovered_nonlinear.extend(verified)

    print(f"  ✅ 二次项还原: {len(recovered_nonlinear)} 项")
    return sorted(set(recovered_nonlinear))
def recover_f_and_g_full(H, max_y_index=160):
    print("=" * 60)
    print("序列复合还原: f + g")
    print("=" * 60)

    B = H.ring()
    linear_mons, quad_mons = [], []
    has_constant = any(m.degree() == 0 for m in H)

    for m in H:
        deg = m.degree()
        if deg == 1:
            linear_mons.append(m)
        elif deg == 2:
            quad_mons.append(m)

    H_lin = sum(linear_mons, B(0))
    H_quad = sum(quad_mons, B(0))
    if has_constant:
        H_lin += B(1)

    print(f"[统计] const={has_constant}, 线性={len(linear_mons)}, 二次={len(quad_mons)}")

    # Step 1: GCD 提取 f
    from functools import reduce
    quad_by_diff = {}
    for m in quad_mons:
        vs = list(m.variables())
        a, b = sorted([_var_to_index(vs[0]), _var_to_index(vs[1])])
        quad_by_diff.setdefault(b - a, []).append((a, b))

    f_candidates = {}
    for d, terms in sorted(quad_by_diff.items()):
        a_vals = sorted(set(min(a, b) for (a, b) in terms))
        best_f, best_score = None, float('-inf')
        for c in range(max(a_vals) + 1):
            fc = set()
            valid = True
            for a in a_vals:
                t = a - c
                if t < 0:
                    valid = False; break
                fc.add(t)
            if not valid or not fc:
                continue
            mx = max(fc)
            if mx > max_y_index:
                continue
            score = -mx
            if score > best_score:
                best_score, best_f = score, fc
        if best_f:
            f_candidates[d] = best_f

    if not f_candidates:
        print("❌ 未能提取 f"); return None

    polys = [sum(B.gen(t) for t in taps) for taps in f_candidates.values()]
    f_gcd = reduce(lambda a, b: a.gcd(b), polys)
    f_taps = sorted(_var_to_index(v) for v in f_gcd.variables())
    print(f"\n[GCD] f_taps ({len(f_taps)}): {f_taps}")

    # Step 2: 带余除法提取 g 线性
    print("\n--- g 线性部分 (带余除法) ---")
    lin_result = recover_g_linear_by_division(H_lin, f_taps, max_y_index)

    # Step 3: 序列复合定义提取 g 二次
    print("\n--- g 二次部分 (序列复合匹配) ---")
    nonlinear_result = recover_g_nonlinear_sequence_composition(H_quad, f_taps, max_y_index)

    g_result = {
        'const': lin_result['const'],
        'linear': lin_result['linear'],
        'nonlinear': nonlinear_result
    }

    print("\n" + "=" * 60)
    print(f"f:     {f_taps}")
    #print(f"g_const:    {g_result['const']}")
    print(f"g_linear:   {g_result['linear']}")
    print(f"g_nonlinear:{g_result['nonlinear']}")
    print("=" * 60)
    return f_taps, g_result


